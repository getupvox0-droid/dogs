// Cloudflare Worker: serves the static game in dist/ and the park API in worker/.
// Workers Builds runs `npm run build`, then `npx wrangler deploy` with this file.
// Secrets (set in the dashboard, never here): TURNSTILE_SECRET, DEVICE_SALT, ADMIN_TOKEN.
{
  "name": "dogs",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Turnstile site key (public). Replace with the key from the Turnstile dashboard.
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dogs-park",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
